{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "debug-logging",
      "displayName": "Debug With Logging",
      "binaryDir": "${sourceDir}/build-logging",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CHRONICLE_ENABLE_LOGGING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "debug-logging",
      "configurePreset": "debug-logging"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-logging",
      "configurePreset": "debug-logging",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
