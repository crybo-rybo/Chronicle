{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug + unit tests",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-16",
        "CMAKE_CXX_COMPILER": "g++-16",
        "CMAKE_BUILD_TYPE": "Debug",
        "CHRONICLE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-16",
        "CMAKE_CXX_COMPILER": "g++-16",
        "CMAKE_BUILD_TYPE": "Release",
        "CHRONICLE_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "ci",
      "displayName": "Warning-clean CI",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build-ci",
      "cacheVariables": {
        "CHRONICLE_WERROR": "ON"
      }
    },
    {
      "name": "linux-ci",
      "displayName": "Warning-clean sanitized Linux CI",
      "inherits": "ci",
      "binaryDir": "${sourceDir}/build-linux-ci",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CHRONICLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "integration",
      "displayName": "Debug + unit and live-LLM integration tests",
      "inherits": "dev",
      "cacheVariables": {
        "CHRONICLE_INTEGRATION_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "ci", "configurePreset": "ci" },
    { "name": "linux-ci", "configurePreset": "linux-ci" },
    { "name": "release", "configurePreset": "release" },
    { "name": "integration", "configurePreset": "integration" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-ci",
      "configurePreset": "linux-ci",
      "output": { "outputOnFailure": true },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1:abort_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "integration",
      "configurePreset": "integration",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "name": "^integration/" } }
    }
  ]
}
