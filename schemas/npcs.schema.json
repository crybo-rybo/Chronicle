{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronicle.dev/schemas/npcs.schema.json",
  "title": "Chronicle NPCs File",
  "description": "NPC identity, initial state, and per-NPC tool policy for the v1 scenario package contract.",
  "type": "object",
  "additionalProperties": true,
  "required": ["npcs"],
  "properties": {
    "npcs": {
      "type": "object",
      "description": "Map of NPC ID to Npc object. The map key is injected as identity.id at load time.",
      "additionalProperties": { "$ref": "#/$defs/npc" }
    }
  },
  "$defs": {
    "mood": {
      "type": "string",
      "description": "Canonical NPC mood vocabulary enforced by ToolRegistry (kValidMoods).",
      "enum": ["fearful", "friendly", "grieving", "hostile", "neutral", "suspicious"]
    },
    "tool_name": {
      "type": "string",
      "description": "v1 NPC tool palette (kValidNpcTools).",
      "enum": [
        "give_item",
        "inspect_item",
        "move_self",
        "remember",
        "reveal_knowledge",
        "say",
        "set_flag",
        "take_item",
        "update_mood",
        "update_trust"
      ]
    },
    "tool_policy": {
      "type": "object",
      "description": "Per-NPC allowlist controlling which framework tools and authored IDs the LLM may use. Empty scoped lists mean no additional ID restriction.",
      "additionalProperties": true,
      "properties": {
        "allowed_tools": {
          "type": "array",
          "description": "Tools this NPC may invoke. Empty list means no tool permissions.",
          "items": { "$ref": "#/$defs/tool_name" }
        },
        "allowed_items": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allowed_facts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allowed_flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allowed_locations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "memory_entry": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "timestamp": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["conversation", "observation", "rumor", "event"]
        },
        "summary": { "type": "string" },
        "importance": { "type": "integer", "minimum": 1, "maximum": 10 },
        "related_npc": { "type": "string" },
        "related_item": { "type": "string" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Optional; the loader injects the map key as id."
        },
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "personality_summary": { "type": "string" },
        "backstory": { "type": "string" },
        "secret": { "type": "string" },
        "goals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "knowledge": {
          "type": "array",
          "description": "Fact IDs this NPC may disclose via reveal_knowledge.",
          "items": { "type": "string" }
        },
        "trust_reveal_threshold": {
          "type": "integer",
          "description": "Minimum trust before secret is exposed in the system prompt.",
          "default": 70
        },
        "tool_policy": { "$ref": "#/$defs/tool_policy" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": true,
      "required": ["current_location"],
      "properties": {
        "current_location": { "type": "string", "minLength": 1 },
        "mood": { "$ref": "#/$defs/mood" },
        "trust_toward_player": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "default": 0
        },
        "inventory": {
          "type": "array",
          "items": { "type": "string" }
        },
        "memories": {
          "type": "array",
          "items": { "$ref": "#/$defs/memory_entry" }
        },
        "has_met_player": { "type": "boolean", "default": false },
        "secret_revealed": { "type": "boolean", "default": false }
      }
    },
    "npc": {
      "type": "object",
      "additionalProperties": true,
      "required": ["identity", "state"],
      "properties": {
        "identity": { "$ref": "#/$defs/identity" },
        "state": { "$ref": "#/$defs/state" }
      }
    }
  }
}
