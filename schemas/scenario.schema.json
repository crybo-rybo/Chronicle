{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronicle.dev/schemas/scenario.schema.json",
  "title": "Chronicle Scenario Manifest",
  "type": "object",
  "required": ["id", "name", "version", "chronicle_schema_version", "files"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "chronicle_schema_version": { "type": "integer", "const": 1 },
    "files": {
      "type": "object",
      "required": ["config", "world", "npcs", "facts", "flags", "events"],
      "properties": {
        "config": { "type": "string" },
        "world": { "type": "string" },
        "npcs": { "type": "string" },
        "facts": { "type": "string" },
        "flags": { "type": "string" },
        "events": { "type": "string" }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "author": { "type": "string" },
        "license": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
