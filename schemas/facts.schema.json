{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronicle.dev/schemas/facts.schema.json",
  "title": "Chronicle Cartridge Facts",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "facts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "category": { "type": "string" },
          "revealed_by_default": { "type": "boolean" }
        }
      }
    }
  }
}
