{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronicle.dev/schemas/facts.schema.json",
  "title": "Chronicle Facts File",
  "description": "Authored fact registry for the v1 scenario package contract. Map keys are injected as fact ids by the loader.",
  "type": "object",
  "additionalProperties": true,
  "required": ["facts"],
  "properties": {
    "facts": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/fact" }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": true,
      "required": ["text", "category", "revealed_by_default"],
      "properties": {
        "text": {
          "type": "string",
          "description": "Author-written fact text shown to the model when an NPC knows this fact."
        },
        "category": {
          "type": "string",
          "description": "Creator-defined grouping label, e.g. 'backstory' or 'clue'."
        },
        "revealed_by_default": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
